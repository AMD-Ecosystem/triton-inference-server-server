#
# Debian 12 + ROCm 10.1.0 (ROCm Core SDK / TheRock) TensorFlow build/test image (standalone)
# Builds everything from scratch (no dependency on prebuilt localhost base images).
#
# ROCm 10.1.0 uses the "ROCm Core SDK" repo (stable.repo.amd.com/rocm/core) and
# amdrocm<ver>-gfxNNN / amdrocm-core-sdk<ver>-gfxNNN package naming, unlike the
# legacy repo.amd.com/rocm/packages-multi-arch repo used by ROCm 7.x.
#

FROM debian:12

# Prevent apt-get from prompting for input
ENV DEBIAN_FRONTEND=noninteractive

# Allow pip to install packages system-wide (needed for Debian 12+)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

WORKDIR /workspace

# Install baseline system dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        wget \
        gnupg2 \
        curl \
        software-properties-common \
        build-essential \
        git \
        pkg-config \
        unzip \
        zip && \
    rm -rf /var/lib/apt/lists/*

# Locale setup for Debian.
RUN sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/g' /etc/locale.gen
RUN echo 'LANG=en_US.UTF-8' > /etc/default/locale
RUN locale-gen en_US.UTF-8
RUN update-locale LANG=en_US.UTF-8

ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Install Python from Debian 12 (default 3.11) and pip.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-venv && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3 && \
    python3 -m pip install --upgrade pip setuptools==69.5.1 wheel && \
    python3 --version && \
    rm -rf /var/lib/apt/lists/*

# Install ROCm 10.1.0 (ROCm Core SDK) from the official Debian 12 APT repository.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    gnupg \
    && mkdir --parents --mode=0755 /etc/apt/keyrings \
    && wget https://stable.repo.amd.com/rocm/gpg/packages.gpg -O - \
    | gpg --dearmor \
    > /etc/apt/keyrings/amdrocm.gpg

RUN printf '%s\n' \
    "X-Repo-Id: amdrocm-stable" \
    "Types: deb" \
    "URIs: https://stable.repo.amd.com/rocm/core/packages/debian12/" \
    "Suites: stable" \
    "Components: main" \
    "Architectures: amd64" \
    "Signed-By: /etc/apt/keyrings/amdrocm.gpg" \
    "Enabled: yes" \
    > /etc/apt/sources.list.d/amdrocm-stable.sources \
    && apt-get update

# ROCm packages for gfx942 only (MI300X / MI325X / MI300A) for quick validation.
# To target other architectures later, install the matching -gfxNNN packages, e.g.:
#   gfx950  -> amdrocm10.1-gfx950  amdrocm-core-sdk10.1-gfx950
#   gfx90a  -> amdrocm10.1-gfx90a  amdrocm-core-sdk10.1-gfx90a
# Verify exact names with `apt-cache search amdrocm` inside the image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    amdrocm10.1-gfx942 amdrocm-core-sdk10.1-gfx942 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/rocm/.info && \
    src_version="$(ls -1 /opt/rocm/core-*/.info/version /opt/rocm/.info/version 2>/dev/null | head -n 1)" && \
    [ -n "${src_version}" ] && cp -p "${src_version}" /opt/rocm/.info/version

# Install libevent (needed by Triton for HTTP/gRPC endpoints).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libevent-2.1-7 \
        libevent-core-2.1-7 \
        libevent-pthreads-2.1-7 \
        libevent-dev && \
    rm -rf /var/lib/apt/lists/*

# Install common runtime dependencies used by Triton.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libb64-0d \
        libcurl4-openssl-dev \
        libre2-9 \
        libre2-dev \
        libnuma-dev \
        libnuma1 \
        libgoogle-perftools-dev \
        libjemalloc-dev && \
    rm -rf /var/lib/apt/lists/*

# Install cmake.
RUN apt update -q=2 && apt install -y wget && \
    wget -q https://github.com/Kitware/CMake/releases/download/v3.31.8/cmake-3.31.8-linux-x86_64.tar.gz && \
    tar -zxf cmake-3.31.8-linux-x86_64.tar.gz -C /opt && \
    rm cmake-3.31.8-linux-x86_64.tar.gz && \
    ln -sf /opt/cmake-3.31.8-linux-x86_64/bin/cmake /usr/local/bin/cmake && \
    ln -sf /opt/cmake-3.31.8-linux-x86_64/bin/ctest /usr/local/bin/ctest && \
    ln -sf /opt/cmake-3.31.8-linux-x86_64/bin/cpack /usr/local/bin/cpack && \
    cmake --version

# TensorFlow ROCm build-specific prerequisites.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        clang-19 \
        lld-19 && \
    rm -rf /var/lib/apt/lists/*

# Install Bazelisk as bazel.
RUN curl -fsSL -o /usr/local/bin/bazel \
      https://github.com/bazelbuild/bazelisk/releases/download/v1.22.0/bazelisk-linux-amd64 && \
    chmod +x /usr/local/bin/bazel

# Set ROCm environment variables.
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV PATH=/opt/rocm/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/rocm/lib:${LD_LIBRARY_PATH:-}
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

# Copy build-and-test helper script into the image.
COPY scripts/repro_tensorflow_rocm_build_test.sh /usr/local/bin/repro_tensorflow_rocm_build_test.sh
COPY patches/tensorflow_tritonapi_build_develop-upstream_adjusted.patch /workspace/patches/tensorflow_tritonapi_build_develop-upstream_adjusted.patch
RUN chmod +x /usr/local/bin/repro_tensorflow_rocm_build_test.sh

# Sensible defaults; script allows overrides via env vars.
ENV TF_REPO=https://github.com/ROCm/tensorflow-upstream.git
ENV TF_BRANCH=develop-upstream
ENV TF_WORKDIR=/workspace
ENV TF_PYTHON_VERSION=3.12

# Build TensorFlow for gfx942 only (MI300X) for quick validation.
# Full target list to restore when building for other architectures:
#   gfx908   (MI100)
#   gfx90a   (MI200 series)
#   gfx942   (MI300 series)
#   gfx950   (MI350 series)
#   gfx1030  (RDNA2)
#   gfx1100, gfx1101, gfx1102 (RDNA3)
#   gfx1200, gfx1201 (RDNA4)
# i.e. gfx908,gfx90a,gfx942,gfx950,gfx1030,gfx1100,gfx1101,gfx1102,gfx1200,gfx1201
ENV TF_ROCM_AMDGPU_TARGETS=gfx942

ENV TF_CLANG_PATH=/usr/lib/llvm-19/bin/clang
ENV TF_PATCH_FILE=/workspace/patches/tensorflow_tritonapi_build_develop-upstream_adjusted.patch

# Run full TensorFlow ROCm build + GPU test during docker build.
# Set RUN_TF_REPRO_DURING_BUILD=0 at build time to skip this step.
ARG RUN_TF_REPRO_DURING_BUILD=1
RUN if [ "${RUN_TF_REPRO_DURING_BUILD}" = "1" ]; then \
      /usr/local/bin/repro_tensorflow_rocm_build_test.sh; \
    else \
      echo "Skipping TensorFlow repro during docker build"; \
    fi

CMD ["/bin/bash"]
