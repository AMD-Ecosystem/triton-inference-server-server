#
# Debian 12 + ROCm 10.0.0 (ROCm Core SDK / TheRock) + Python 3.11 Base Image
# This base image is used by all Triton build stages for onnxruntime/python backend with ROCm enabled on Debian OS to avoid redundant installations
#
# NOTE: ROCm 10.0.0 moved to the "ROCm Core SDK" package/repo layout (built on
# TheRock). This replaces the legacy repo.amd.com/rocm/packages-multi-arch
# repo + amdrocmX.Y-gfxNNN package naming used by ROCm 7.x with the new
# stable.repo.amd.com/rocm/core repo + amdrocm-core-sdkX.Y[-gfxNNN] naming.
# See: https://rocm.docs.amd.com/en/docs-10.0.0/about/transition-guide-TheRock.html
#

FROM debian:12

# Prevent apt-get from prompting for input
ENV DEBIAN_FRONTEND=noninteractive

# Allow pip to install packages system-wide (needed for Debian 12+)
ENV PIP_BREAK_SYSTEM_PACKAGES=1

WORKDIR /workspace

# Install basic dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        wget \
        gnupg2 \
        curl \
        software-properties-common \
        build-essential \
        git \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Need this for debian
RUN sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/g' /etc/locale.gen
RUN echo 'LANG=en_US.UTF-8' > /etc/default/locale
RUN locale-gen en_US.UTF-8
RUN update-locale LANG=en_US.UTF-8

ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Install Python from Debian 12 (bookworm) - default is 3.11
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-venv && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3 && \
    python3 -m pip install --upgrade pip setuptools==69.5.1 wheel && \
    python3 --version && \
    rm -rf /var/lib/apt/lists/*

# Install ROCm 10.0.0 (ROCm Core SDK) from the official Debian 12 APT repository.
#
# NOTE: this is a *different* repo/keyring than legacy ROCm (repo.amd.com/rocm/
# packages-multi-arch). ROCm Core SDK releases (7.14.0+) are published under
# stable.repo.amd.com/rocm/core.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    gnupg \
    && mkdir --parents --mode=0755 /etc/apt/keyrings \
    && wget https://stable.repo.amd.com/rocm/gpg/packages.gpg -O - \
    | gpg --dearmor \
    > /etc/apt/keyrings/amdrocm.gpg

RUN printf '%s\n' \
    "X-Repo-Id: amdrocm-stable" \
    "Types: deb" \
    "URIs: https://stable.repo.amd.com/rocm/core/packages/debian12/" \
    "Suites: stable" \
    "Components: main" \
    "Architectures: amd64" \
    "Signed-By: /etc/apt/keyrings/amdrocm.gpg" \
    "Enabled: yes" \
    > /etc/apt/sources.list.d/amdrocm-stable.sources \
    && apt-get update

# Install the ROCm Core SDK for the gfx942 (CDNA3 / MI300X / MI325X / MI300A)
# architecture family. NOTE: package names for 10.0 follow the ROCm Core SDK
# convention (amdrocm-core-sdk<version>[-gfx<arch>]); verify against
# `apt-cache search amdrocm` in this base image if the exact name has moved
# by the time you build this.
RUN apt-get update && apt-get install -y --no-install-recommends \
    amdrocm10.0-gfx942 amdrocm-core-sdk10.0-gfx942 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/rocm/.info && \
    src_version="$(ls -1 /opt/rocm/core-*/.info/version /opt/rocm/.info/version 2>/dev/null | head -n 1)" && \
    [ -n "${src_version}" ] && cp -p "${src_version}" /opt/rocm/.info/version

# Install libevent (needed by Triton for HTTP/gRPC endpoints)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libevent-2.1-7 \
        libevent-core-2.1-7 \
        libevent-pthreads-2.1-7 \
        libevent-dev && \
    rm -rf /var/lib/apt/lists/*

# Install common runtime dependencies used by Triton
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libb64-0d \
        libcurl4-openssl-dev \
        libre2-9 \
        libre2-dev \
        libnuma-dev \
        libnuma1 \
        libgoogle-perftools-dev \
        libjemalloc-dev && \
    rm -rf /var/lib/apt/lists/*


# Install cmake
RUN apt update -q=2 && apt install -y wget && \
    wget -q https://github.com/Kitware/CMake/releases/download/v3.31.8/cmake-3.31.8-linux-x86_64.tar.gz && \
    tar -zxf cmake-3.31.8-linux-x86_64.tar.gz -C /opt && \
    rm cmake-3.31.8-linux-x86_64.tar.gz && \
    ln -sf /opt/cmake-3.31.8-linux-x86_64/bin/cmake /usr/local/bin/cmake && \
    ln -sf /opt/cmake-3.31.8-linux-x86_64/bin/ctest /usr/local/bin/ctest && \
    ln -sf /opt/cmake-3.31.8-linux-x86_64/bin/cpack /usr/local/bin/cpack && \
    cmake --version

# Set ROCm environment variables
ENV ROCM_PATH=/opt/rocm
ENV HIP_PATH=/opt/rocm
ENV PATH=/opt/rocm/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/rocm/lib:${LD_LIBRARY_PATH:-}
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5
